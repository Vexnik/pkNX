@using Microsoft.AspNetCore.Components.Forms

<main>
    <h1>Trainer editor, step 1</h1>
    <p>Choose the trainer files from your dump. They are read in this browser and are never uploaded.</p>

    <InputFile OnChange="OnFilesChosen" multiple />

    @if (files.Count == 0)
    {
        <p class="empty">No files chosen yet.</p>
    }
    else
    {
        <p>@files.Count file(s) chosen:</p>
        <ul>
            @foreach (var f in files)
            {
                <li>@f.Name (@f.Size bytes)</li>
            }
        </ul>
    }
</main>

@code {
    private readonly List<IBrowserFile> files = new();

    private void OnFilesChosen(InputFileChangeEventArgs e)
    {
        files.Clear();
        files.AddRange(e.GetMultipleFiles(500));
    }
}
