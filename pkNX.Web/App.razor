@using System.IO
@using System.IO.Compression
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using pkNX.Structures
@inject IJSRuntime JS

<main>
    <h1>Galar Reforged — Trainer Editor</h1>
    <p>
        Import trainer team files or a ZIP containing them.
        Files are processed locally in this browser.
    </p>

    <label for="edition">Target game</label>
    <select id="edition" @bind="edition">
        <option value="Sword">Pokémon Sword</option>
        <option value="Shield">Pokémon Shield</option>
    </select>

    <section class="file-picker" aria-labelledby="file-picker-heading">
        <h2 id="file-picker-heading">Choose trainer files</h2>
        <p>Select individual trainer team files or a ZIP containing them.</p>
        <InputFile id="trainer-files" OnChange="OnFilesChosen" multiple />
        <p class="hint">On a tablet, tap the file-selection control above to browse your files.</p>
    </section>

    @if (message is not null)
    {
        <p role="status">@message</p>
    }

    @if (teams.Count > 0)
    {
        <h2>Trainer teams (@teams.Count)</h2>
        <input type="search" placeholder="Filter trainer or Pokémon"
               @bind="filter" @bind:event="oninput" />

        <div class="team-list">
            @foreach (var t in VisibleTeams)
            {
                var index = teams.IndexOf(t);
                <button @key="t" @onclick="() => SelectTeam(index)">
                    @(selectedTeamIndex == index ? "▶ " : "")
                    @t.Name (@t.Team.Length Pokémon)
                </button>
            }
        </div>

        @if (SelectedTeam is not null)
        {
            <h2>Selected trainer</h2>
            <p>@SelectedTeam.Name</p>
            <div class="pokemon-list">
                @for (int i = 0; i < SelectedTeam.Team.Length; i++)
                {
                    var pokemonIndex = i;
                    var p = SelectedTeam.Team[i];
                    <button @key="pokemonIndex"
                            @onclick="() => SelectPokemon(pokemonIndex)">
                        @(selectedPokemonIndex == pokemonIndex ? "▶ " : "")
                        @SpeciesName(p.Species) — Lv. @p.Level
                    </button>
                }
            </div>
        }

        @if (SelectedPokemon is not null)
        {
            <section class="editor">
                <h2>Edit Pokémon</h2>
                <p>Current species: <strong>@SpeciesName(SelectedPokemon.Species)</strong></p>

                <label for="species-id">Species ID</label>
                <input id="species-id" type="number" min="0" max="65535"
                       @bind="SelectedPokemon.Species" />

                <label for="pokemon-level">Level</label>
                <input id="pokemon-level" type="number" min="1" max="100"
                       @bind="SelectedPokemon.Level" />

                <label for="held-item">Held item ID (0 means no item)</label>
                <input id="held-item" type="number" min="0" max="65535"
                       @bind="SelectedPokemon.HeldItem" />

                <h3>Move IDs</h3>
                <label for="move-1">Move 1</label>
                <input id="move-1" type="number" min="0" max="65535"
                       @bind="SelectedPokemon.Move1" />

                <label for="move-2">Move 2</label>
                <input id="move-2" type="number" min="0" max="65535"
                       @bind="SelectedPokemon.Move2" />

                <label for="move-3">Move 3</label>
                <input id="move-3" type="number" min="0" max="65535"
                       @bind="SelectedPokemon.Move3" />

                <label for="move-4">Move 4</label>
                <input id="move-4" type="number" min="0" max="65535"
                       @bind="SelectedPokemon.Move4" />

                <p>Changes apply to the selected Pokémon in memory. Other Pokémon fields are preserved when the team is written.</p>
            </section>
        }

        <hr />
        <section>
            <h2>Export patch</h2>
            <p>Only changed team files are included. The ZIP contains the selected game's Atmosphère mod-folder path.</p>
            <button class="primary-button" @onclick="ExportPatch">Export changed teams</button>
        </section>
    }
</main>

@code {
    private sealed class TeamFile
    {
        public string Name { get; }
        public TrainerPoke8[] Team { get; }
        public byte[] OriginalData { get; }

        public TeamFile(string name, byte[] originalData, TrainerPoke8[] team)
        {
            Name = name;
            OriginalData = originalData;
            Team = team;
        }
    }

    private readonly List<TeamFile> teams = new();
    private string? message;
    private string filter = "";
    private string edition = "Sword";
    private int selectedTeamIndex = -1;
    private int selectedPokemonIndex;

    private TeamFile? SelectedTeam =>
        selectedTeamIndex >= 0 && selectedTeamIndex < teams.Count
            ? teams[selectedTeamIndex]
            : null;

    private TrainerPoke8? SelectedPokemon =>
        SelectedTeam is not null &&
        selectedPokemonIndex >= 0 &&
        selectedPokemonIndex < SelectedTeam.Team.Length
            ? SelectedTeam.Team[selectedPokemonIndex]
            : null;

    private IEnumerable<TeamFile> VisibleTeams =>
        string.IsNullOrWhiteSpace(filter)
            ? teams
            : teams.Where(t =>
                t.Name.Contains(filter.Trim(), StringComparison.OrdinalIgnoreCase) ||
                t.Team.Any(p => SpeciesName(p.Species).Contains(
                    filter.Trim(), StringComparison.OrdinalIgnoreCase)));

    private static string SpeciesName(int id) => ((Species)id).ToString();

    private void SelectTeam(int index)
    {
        selectedTeamIndex = index;
        selectedPokemonIndex = 0;
    }

    private void SelectPokemon(int index) => selectedPokemonIndex = index;

    private async Task OnFilesChosen(InputFileChangeEventArgs e)
    {
        teams.Clear();
        selectedTeamIndex = -1;
        selectedPokemonIndex = 0;
        message = null;
        int skipped = 0;

        try
        {
            var raw = new List<(string Name, byte[] Data)>();

            foreach (var file in e.GetMultipleFiles(2000))
            {
                await using var stream = file.OpenReadStream(300_000_000);
                using var memory = new MemoryStream();
                await stream.CopyToAsync(memory);

                if (file.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
                {
                    memory.Position = 0;
                    using var zip = new ZipArchive(memory, ZipArchiveMode.Read);

                    foreach (var entry in zip.Entries.Where(z =>
                                 z.Length > 0 && !string.IsNullOrEmpty(z.Name)))
                    {
                        // Prefer files from the known trainer_poke folder when
                        // the ZIP contains a full extracted game directory.
                        var normalizedPath = entry.FullName.Replace('\\', '/');
                        bool looksLikeTrainerFile =
                            normalizedPath.Contains("/trainer_poke/", StringComparison.OrdinalIgnoreCase) ||
                            normalizedPath.StartsWith("trainer_poke/", StringComparison.OrdinalIgnoreCase);

                        // Keep other entries available too: some archives contain
                        // only the selected trainer files without their folder path.
                        using var entryStream = entry.Open();
                        using var entryMemory = new MemoryStream();
                        await entryStream.CopyToAsync(entryMemory);
                        raw.Add((entry.FullName, entryMemory.ToArray()));
                    }
                }
                else
                {
                    raw.Add((file.Name, memory.ToArray()));
                }
            }

            foreach (var (name, data) in raw.OrderBy(z => z.Name, StringComparer.Ordinal))
            {
                if (data.Length == 0 || data.Length % TrainerPoke8.SIZE != 0)
                {
                    skipped++;
                    continue;
                }

                var team = TrainerPoke8.ReadTeam(data, null!);
                teams.Add(new TeamFile(name, data, team));
            }

            if (teams.Count > 0)
            {
                selectedTeamIndex = 0;
                message = $"Loaded {teams.Count} team file(s).";
            }
            else
            {
                message = "No valid team files were found. Choose trainer_poke files or a ZIP containing them.";
            }

            if (skipped > 0)
                message += $" Skipped {skipped} file(s) that did not match the expected record size.";
        }
        catch (Exception ex)
        {
            message = "Could not read the selected files: " + ex.Message;
        }
    }

    private async Task ExportPatch()
    {
        message = null;

        try
        {
            string titleId = edition == "Shield"
                ? "01008DB008C2C000"
                : "0100ABF008968000";

            var changed = new List<(string Name, byte[] Data)>();

            foreach (var teamFile in teams)
            {
                var writableTeam = teamFile.Team.Cast<TrainerPoke>().ToList();
                byte[] output = TrainerPoke8.WriteTeam(writableTeam, null!);

                if (!output.SequenceEqual(teamFile.OriginalData))
                    changed.Add((Path.GetFileName(teamFile.Name), output));
            }

            if (changed.Count == 0)
            {
                message = "No changes detected. Edit a Pokémon before exporting.";
                return;
            }

            using var outputMemory = new MemoryStream();
            using (var zip = new ZipArchive(outputMemory, ZipArchiveMode.Create, leaveOpen: true))
            {
                foreach (var file in changed)
                {
                    string entryName =
                        $"atmosphere/contents/{titleId}/romfs/bin/trainer/trainer_poke/{file.Name}";

                    var entry = zip.CreateEntry(entryName, CompressionLevel.Optimal);
                    await using var entryStream = entry.Open();
                    await entryStream.WriteAsync(file.Data);
                }
            }

            string base64 = Convert.ToBase64String(outputMemory.ToArray());
            string filename = $"galar-reforged-{edition.ToLowerInvariant()}-patch.zip";

            await JS.InvokeVoidAsync(
                "downloadBase64File", filename, base64, "application/zip");

            message = $"Export prepared with {changed.Count} changed team file(s).";
        }
        catch (Exception ex)
        {
            message = "Export failed: " + ex.Message;
        }
    }
}
